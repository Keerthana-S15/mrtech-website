# =============================================================================
# Copy this file to backend/.env and fill in real values.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored and excluded from the Docker build context, so
# secrets never reach a git commit or an image layer. Ask the team lead for
# the real values — do not paste them into chat, tickets or PRs.
# =============================================================================

# ---- server ----
# Left here for running outside Docker. docker-compose overrides it to 3000
# and maps the host port separately (HOST_PORT).
PORT=3000

# ---- admin bootstrap (POST /api/setup-admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change-me

# ---- auth ----
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Fast2SMS: mobile OTP for the Request Demo flow ----
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_ENTITY_ID=
# The Message ID shown in the Fast2SMS DLT Manager — a short number such as
# 209725. NOT the 19-digit template ID from the operator's DLT portal: that
# makes every send fail with 424 "Invalid Message ID". OTPs use this route
# only, so if it is wrong no SMS goes out at all.
FAST2SMS_TEMPLATE_ID=
FAST2SMS_OTP_ID=

# ---- Brevo: transactional email OTP ----
# The sending IP must be allowed under Brevo → Security → Authorised IPs.
BREVO_API_KEY=

# ---- Shiprocket: order shipping ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Firebase ----
# Optional. Leave unset when mounting backend/serviceAccountKey.json (the
# docker-compose default). If you set it instead, paste the whole
# service-account JSON on ONE line and delete the volume mount in
# docker-compose.yml — config/firebase.js prefers this variable.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
