# Copy to .env (local) or set these in the Render dashboard → Environment.
# Never commit real values.

PORT=3000
ADMIN_EMAIL=
ADMIN_PASS=
JWT_SECRET=

# Email OTPs + notifications (Brevo transactional API)
BREVO_API_KEY=

# Mobile OTPs (Fast2SMS)
FAST2SMS_API_KEY=
# DLT route (preferred): approved sender ID + template/message ID from Fast2SMS → DLT Manager
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_ENTITY_ID=
# Smart OTP route (fallback): OTP ID from Fast2SMS → OTP section
FAST2SMS_OTP_ID=

# ShipRocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Firebase Admin (JSON string of the service account) — used on Render instead of serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=
